{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motiv",
  "version": "0.1.0",
  "identifier": "se.micke.motiv",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Motiv",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}